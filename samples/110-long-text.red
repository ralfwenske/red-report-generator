Red [
    Title: "110-long-text"
    Demo:  "A longer text report"
    Level: 1
    Needs: 'View
]

if exists? %samples/ [      ;make sure we are in the script directory
    change-dir %samples/
]
; assets/what-functions.txt is a one-block snapshot generated by
; assets/utils/make-what-functions.red (run with the same Red/View build):
;   [ ["action!"   [ ["name" "description"] ... ] ]
;     ["function!" [ ... ] ] ... ]
; Loading it keeps this report reproducible: calling `what` here would include
; whatever functions the running session (e.g. sampler.red) has defined.

unless exists? %../assets/what-functions.txt [
    print "110-long-text: missing assets/what-functions.txt; run assets/utils/make-what-functions.red"
]
functions: either exists? %../assets/what-functions.txt [load %../assets/what-functions.txt][copy []]

whats: func [/local res what-string chapter wf] [
    res: copy []                       ; copy: `res: []` is a shared literal that appends across calls
    foreach chapter functions [ ; action!  function! ...
        what-string: copy []
        append/only what-string         ;replace footer to show (w/1)
            compose/deep [FOOTER [
                [[red8 red1] (rejoin ["  " uppercase chapter/1 "   "]) "  modified per chapter  " "  <page> of <pages>  " ] ; on page 2,3...
            ]]
        append/only what-string [PAGEBREAK] ;force new page for new (chapter/1)
        append/only what-string compose/deep [[(uppercase chapter/1)] [h2 red]] ; h2 sets TOC
        foreach wf chapter/2 [
            append/only what-string compose/deep [[m/10 ] (wf/1) [px/170] (wf/2) [s/7 ]]
        ]
        append res what-string
    ]
    res
]

; A literal <page>/<pages>/<now> in text is written \\<page> (backslash + token):
; the renderer's token pass turns it back into plain text. The source listing is
; generated text, so escape the tokens in it before using it as a line value.
escape-tokens: func [s [string!]][
    s: replace/all copy s "<pages>" "\<pages>"
    s: replace/all s "<page>" "\<page>"
    replace/all s "<now>" "\<now>"
]

report-source:  [ margin/10
    [HEADER 
    []      ; no header on first page
    [
        ["Red Report Generator" [h1] "" (now/date) ]
        ["" "***" (now) [datetime]]
        []
    ]]
    [BODY [    
        []  
        []  
        []  
        []
        [[f1] "Demo: HEADER FOOTER dynamics"]
        []
        ["Calling " "  what  " [f2] "in red terminal shows a long list of words."]
        ["Here we report all data returned from calling " "what" [i b]]
        []       
        []
        ["Table of Contents" [f1]]
        []
        [TOC [
            ["<h2>"       [s px/300 link/toc]     "<t-page>" [s]]
            ["    <h3>"       [s px/300 link/toc]     "<t-page>" [s]]
            []
        ]]
        (whats)
        [FOOTER [
             [[red8 red1] (rejoin ["  REPORT SOURCE CODE   "]) " footer is modified per chapter  " "  <page> of <pages>  " ]
        ]]
        [PAGEBREAK]
        ["Source of this app:" [h3]]
        []
        [FRAME 8 [
            [[m/7 b white] "report: " (escape-tokens mold report-source)]
        ][
            pen red6  fill-pen gray7  line-width 3
            box (as-pair x y) (as-pair x + w y + h) 6
        ]]
    ]]
    [FOOTER [
        ["What function demo" "" "Page <page> of <pages>"] ; on page 1
    ][
        ["" "" "<page> of <pages>" ]                        ; on page 2,3...
    ]]
]

; Pass the report block literally: the renderer evaluates parens (including the
; `(whats)` item and the `(now)` / `(mold ...)` line values) itself, and it
; deliberately defers DRAW/DRAW-BG/FRAME ops so their parens — e.g.
; `(as-pair x y)` — are evaluated later against the frame's draw env.
; `compose/deep` here would evaluate those ops' parens now, where x/y don't exist.
report: report-source
#include %../libs/report-view.red
show-report/fit-width report "110-long-text %page-size%"

