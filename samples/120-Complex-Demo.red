Red [
    File: %120-Complex-Demo.red
    Title: "120 — Complex Demo"
    Demo:  "A complex report with many lines and pages"
]

if exists? %samples/ [      ;make sure we are in the script directory
    change-dir %samples/    ;(we could be started from elsewhere)
]

short-report-code: mold [
report: [
    [HEADER [
        ["Red Report Generator" [f1] "" (now/date) ]
        ["" "***" (now) [datetime]]
        []
    ]]
    [BODY [
        ["Hello World" [f2 purple]]
        ["and line after line"]
        []
        [[b i] "and a blank line" " preceding this one" [!b]]
    ]]
    [FOOTER [
        ["Footer" [f3] "" "Page <page> of <pages>"]
    ]] ]
]

report: [ margin/10 left/30 right/15
    [DRAW-BG 3 [
        pen off
        fill-pen red3                         ; spine down the left edge
        box 0x0 (as-pair 10 page-height)
        box 0x0 (as-pair page-width 10)
    ]]  
    [HEADER [
        [[f3] "Red Report Generator"  "Complex Demo" (now/date) ]
        [[s/6] "by Ralf and Deepseek" "" "Page <page> of <pages>"]
        []
    ]]
    [BODY [
        ["Fundamentals of the Red Report Generator" [f2]]
        ["This is a demo report to demonstrate report generator features" [b i]] 
        []
        ["A first overview :" [f3]]
        []
        [[ss/9]
{A report is a block of items. [BODY [...]] is the required section; each block inside it is one (or -when wrapped- several) line(s) on the page. 
HEADER and FOOTER are optional; they are repeated on every page. Of which the first three values are placed on the left, centre and right of the line. <page> and <pages> are replaced with the page number and total pages.
}]
[]
    [FRAME 8 [
            [[ss/7 yellow ] ( short-report-code )
    ]]
        [
            pen red  fill-pen coffee line-width 1
            box (as-pair x y) (as-pair x + w y + h) 6
        ] 
    ] ;FRAME
        []
        [
{Try to understand the next page, 
which shows the entire } {  Red source code } [black white black]  { building this report.
Except short-report-code, which is a global string containing the source code.
(It's content is shown in the frame above.)}
        ]
        []
        [PAGEBREAK]
        ["This view / pdf report is generated by the following code:" [f3]] 
        [DRAW 5 [pen black fill-pen off line-width 1
            line (as-pair x - 10 y ) (as-pair w + 30 y)
        ]]
        ["Red []" [ss/7]]      
        [[ss/7] ""]
        [FRAME 8  [
            [[ss/7 yellow] (rejoin ["report:  " (mold report)])]  ; source-1 contains the source as string        
        ][            
            pen red  fill-pen coffee  line-width 2
            box (as-pair x y) (as-pair x + w y + h ) 6
        ]]
        [[ss/7] ""] 
        [[ss/7] {#include %../libs/report-view.red
error-msg: show-report/fit-width report "005-Large-Demo"
if error-msg <> "" [alert error-msg]}
        ]
    ]]
    [FOOTER [
        ["Footer" [f3] "" (now) [time]]

    ]]
]

#include %../libs/report-view.red
error-msg: show-report/fit-width report "005-Large-Demo"
if error-msg <> "" [print error-msg]