Red [
    Title: "100-long-text"
    Demo:  "A longer text report"
    Level: 1
    Needs: 'View
]

group-rows: function [rows [block!]] [
    result: copy []
    last-type: none
    group: none
    foreach row rows [
        either row/1 = last-type [
            append group reduce  [next row]
        ][
            last-type: row/1
            group: copy []
            append/only result reduce [last-type group]
            append group reduce [next row]
        ]
    ]
    result
]; group-rows

what-functions: does [
    ; Snapshot of Red's function list, generated by assets/make-what-functions.red
    ; (run with the same Red/View build). Reading the file keeps this report
    ; reproducible: calling `what` here would include whatever functions the
    ; running session (e.g. sampler.red) has defined.
    unless exists? %../assets/what-functions.txt [
        print "100-long-text: missing assets/what-functions.txt; run assets/make-what-functions.red"
    ]
    lines: either exists? %../assets/what-functions.txt [read/lines %../assets/what-functions.txt][copy []]
    result: collect [
        foreach line lines [
            keep/only parse line [
                collect [some %" "
                    keep copy w to #" " some #" "   ; word + skip all spaces
                    keep copy t to #" " some #" "   ; type + skip all spaces
                    keep copy d to end              ; rest
                ]
            ]
        ]
    ]
    result2: copy []
    foreach item result [
        unless none? item/1 [ 
            append/only result2 reduce [item/2 item/1 item/3]
        ]
    ]
    group-rows sort result2
]; what-functions

whats: func [] [
    res: []
    foreach item what-functions [ ; action!  function! ...
        what-string: copy []
        append/only what-string         ;replace header to show (w/1)
            compose/deep [HEADER [
                ["Red Report Generator" [h1] "" (now/date) ]
                [(rejoin ["Type: " (uppercase item/1)]) [h3 red] "" (now) [datetime]]
                []
            ]]
        append/only what-string         ;replace footer to show (w/1)
            compose/deep [FOOTER [
                [(uppercase item/1) "" "<page> of <pages>" ]                        ; on page 2,3...
            ]]
        append/only what-string [PAGEBREAK] ;force new page for new (item/1)
        foreach wf item/2 [
            append/only what-string compose/deep [[m/10 ] (wf/1) [px/170] (wf/2) [s/7 ]]
        ]
        append res what-string
    ]
    res
]

report: compose/deep [ margin/10
    [HEADER [
        ["Red Report Generator" [h1] "" (now/date) ]
        ["" "***" (now) [datetime]]
        []
    ][
        ["Header Test" [h2] "" "This is a header for page 2 and after"] ; on page 2,3...
    ]]
    [BODY [    
        [[h3] "demonstrating HEADER FOOTER dynamics"]
        ["these functions generate all content of this report"]
        []
        [[m/9] "group-rows: " (mold :group-rows)] 
        [[m/9] "what-functions: " (mold :what-functions)] 
        [{;     what-functions returns this block structure:
            [  ["action!"   [ ["absolute" "Returns the non-negative value."     ] ]
               ["function!" [ ["pair?" "Returns true if the value is this type."] ] ]
        }]
        (whats)
    ]]
    [FOOTER [
        ["What function demo" "" "Page <page> of <pages>"] ; on page 1
    ][
        ["" "" "<page> of <pages>" ]                        ; on page 2,3...
    ]]
]

#include %../libs/report-view.red
show-report/fit-width report "100-long-text %page-size%"

